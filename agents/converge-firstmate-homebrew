#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  printf 'usage: %s <brew-executable> <homebrew-owner>\n' "$0" >&2
  exit 2
fi

brew=$1
owner=$2

if [ ! -x "$brew" ]; then
  printf 'firstmate-homebrew: brew executable is unavailable: %s\n' "$brew" >&2
  exit 1
fi

brew_dir=${brew%/*}
PATH="$brew_dir:$PATH"
export PATH

environment=(
  HOMEBREW_FORCE_API_AUTO_UPDATE=1
  HOMEBREW_NO_AUTO_UPDATE=1
  HOMEBREW_NO_INSTALL_CLEANUP=1
  HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
)
arguments=(
  upgrade
  --greedy
  --no-ask
  pi-coding-agent
  herdr
  antigravity-cli
)

if [ "$(id -un)" = "$owner" ]; then
  env "${environment[@]}" "$brew" "${arguments[@]}"
else
  /usr/bin/sudo --preserve-env=PATH --user="$owner" --set-home \
    env "${environment[@]}" "$brew" "${arguments[@]}"
fi
