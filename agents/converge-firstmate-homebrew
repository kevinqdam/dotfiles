#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  printf 'usage: %s <brew-executable> <homebrew-owner>\n' "$0" >&2
  exit 2
fi

brew=$1
owner=$2

if [ ! -x "$brew" ]; then
  printf 'firstmate-homebrew: brew executable is unavailable: %s\n' "$brew" >&2
  exit 1
fi

brew_dir=${brew%/*}
PATH="$brew_dir:$PATH"
export PATH

environment=(
  HOMEBREW_FORCE_API_AUTO_UPDATE=1
  HOMEBREW_NO_AUTO_UPDATE=1
  HOMEBREW_NO_INSTALL_CLEANUP=1
  HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
)

run_brew() {
  if [ "$(id -un)" = "$owner" ]; then
    env "${environment[@]}" "$brew" "$@"
  else
    /usr/bin/sudo --preserve-env=PATH --user="$owner" --set-home \
      env "${environment[@]}" "$brew" "$@"
  fi
}

# This explicit allowlist is the narrow exception to Homebrew's global
# upgrade=false boundary. It includes the Firstmate formulas and every
# declared desktop cask except Anaconda and installer-manual Logi Tune.
targeted_upgrades=(
  pi-coding-agent
  herdr
  antigravity-cli
  chatgpt
  codex
  google-drive
  google-chrome
  google-gemini
  iterm2
  raycast
  superwhisper
  tailscale-app
  visual-studio-code
)

# Homebrew owns installation and versioning for these targeted packages.
# Preserve its diagnostics and exit status so an exceptional pre-existing
# conflict remains an operator-visible one-time repair instead of becoming
# package logic here. Cask upgrades may download a new payload and replace the
# installed application bundle.
run_brew upgrade --greedy --no-ask "${targeted_upgrades[@]}"
