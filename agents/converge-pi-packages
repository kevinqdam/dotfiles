#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  printf 'usage: %s <pi-executable> <agent-directory> [effective-state-checker]\n' "$0" >&2
  exit 2
fi

pi=$1
agent_dir=$2
effective_state_checker=${3:-${0%/*}/pi-effective-package-state.mjs}
while [ "$agent_dir" != "/" ] && [ "${agent_dir%/}" != "$agent_dir" ]; do
  agent_dir=${agent_dir%/}
done
if [ -d "$agent_dir" ]; then
  if ! agent_dir=$(cd "$agent_dir" && pwd -P); then
    printf 'pi-packages: unable to resolve the Pi agent directory: %s\n' "$2" >&2
    exit 1
  fi
else
  agent_parent=${agent_dir%/*}
  agent_name=${agent_dir##*/}
  [ "$agent_parent" = "$agent_dir" ] && agent_parent=.
  if ! agent_parent=$(cd "$agent_parent" && pwd -P); then
    printf 'pi-packages: unable to resolve the Pi agent directory parent: %s\n' "$2" >&2
    exit 1
  fi
  agent_dir="$agent_parent/$agent_name"
fi
reviewed_pi_version='0.84.3'
awk_bin=/usr/bin/awk
jq_bin=jq
git_bin=git
node_bin=node

# These are the reviewed package sources. Keep the exact npm versions and git
# commit fixed here so activation never follows a mutable release or branch.
package_specs=(
  'npm:@llblab/pi-telegram@0.39.2'
  'npm:pi-web-access@0.25.0'
  'npm:@ryan_nookpi/pi-extension-codex-fast-mode@0.2.6'
  'git:github.com/algal/pi-openai-server-compaction@c6d593087709e9481223dc6c6c2269b371b5e055'
)

if [ ! -x "$pi" ]; then
  printf 'pi-packages: Pi executable is unavailable: %s\n' "$pi" >&2
  exit 1
fi
if [ ! -x "$awk_bin" ]; then
  printf 'pi-packages: macOS awk executable is unavailable: %s\n' "$awk_bin" >&2
  exit 1
fi
if ! command -v "$jq_bin" >/dev/null 2>&1; then
  printf 'pi-packages: jq is unavailable in the activation PATH\n' >&2
  exit 1
fi
if ! command -v "$git_bin" >/dev/null 2>&1; then
  printf 'pi-packages: git is unavailable in the activation PATH\n' >&2
  exit 1
fi
if ! command -v "$node_bin" >/dev/null 2>&1; then
  printf 'pi-packages: node is unavailable in the activation PATH\n' >&2
  exit 1
fi

if [ -n "${PI_PACKAGE_MANAGER_SDK:-}" ]; then
  pi_package_manager_sdk=$PI_PACKAGE_MANAGER_SDK
else
  if ! pi_real=$(/usr/bin/readlink -f "$pi"); then
    printf 'pi-packages: unable to resolve the Pi executable: %s\n' "$pi" >&2
    exit 1
  fi
  pi_prefix=${pi_real%/bin/pi}
  pi_package_manager_sdk="$pi_prefix/libexec/lib/node_modules/@earendil-works/pi-coding-agent/dist/index.js"
fi
if [ ! -f "$pi_package_manager_sdk" ]; then
  printf 'pi-packages: installed Pi package-manager SDK is unavailable: %s\n' "$pi_package_manager_sdk" >&2
  exit 1
fi
if [ ! -f "$effective_state_checker" ]; then
  printf 'pi-packages: effective package-state checker is unavailable: %s\n' "$effective_state_checker" >&2
  exit 1
fi

# The compaction source was proven against this Pi release in an isolated agent
# directory. Refuse all reviewed package changes when that compatibility anchor
# is not the installed Pi, rather than installing an unreviewed combination.
if ! installed_pi_version=$(PI_CODING_AGENT_DIR="$agent_dir" "$pi" --version); then
  printf 'pi-packages: unable to determine the installed Pi version\n' >&2
  exit 1
fi
if [ "$installed_pi_version" != "$reviewed_pi_version" ]; then
  printf 'pi-packages: refusing reviewed package pins for Pi %s; compatibility was established only for Pi %s\n' \
    "$installed_pi_version" "$reviewed_pi_version" >&2
  exit 1
fi

list_packages() {
  PI_CODING_AGENT_DIR="$agent_dir" "$pi" list
}

# Pi's list output is the public package-manager view of configured sources and
# their install paths.
installed_path_for_source() {
  list_output=$1
  source_spec=$2
  expected_path=$3
  # shellcheck disable=SC2016
  printf '%s\n' "$list_output" |
    "$awk_bin" -v spec="$source_spec" -v expected="$expected_path" '
      $0 == "User packages:" { user_packages = 1; next }
      $0 == "Project packages:" { user_packages = 0; next }
      user_packages && ($0 == "  " spec || $0 == "  " spec " (filtered)") { package_seen = 1; next }
      package_seen && $0 ~ /^    / {
        path = substr($0, 5)
        if (path == expected) { print path; found = 1; exit }
        if (fallback == "") fallback = path
        package_seen = 0
        next
      }
      package_seen { package_seen = 0 }
      END { if (!found && fallback != "") print fallback }
    '
}

package_name_for_source() {
  case "$1" in
    npm:@llblab/pi-telegram@*)
      printf '%s\n' '@llblab/pi-telegram'
      ;;
    npm:pi-web-access@*)
      printf '%s\n' 'pi-web-access'
      ;;
    npm:@ryan_nookpi/pi-extension-codex-fast-mode@*)
      printf '%s\n' '@ryan_nookpi/pi-extension-codex-fast-mode'
      ;;
    git:github.com/algal/pi-openai-server-compaction@*)
      printf '%s\n' 'pi-openai-server-compaction'
      ;;
    *)
      printf 'pi-packages: unknown reviewed package source: %s\n' "$1" >&2
      return 1
      ;;
  esac
}

package_version_for_source() {
  case "$1" in
    npm:@llblab/pi-telegram@*) printf '%s\n' '0.39.2' ;;
    npm:pi-web-access@*) printf '%s\n' '0.25.0' ;;
    npm:@ryan_nookpi/pi-extension-codex-fast-mode@*) printf '%s\n' '0.2.6' ;;
    git:github.com/algal/pi-openai-server-compaction@*) printf '%s\n' '0.1.0' ;;
    *)
      printf 'pi-packages: unknown reviewed package source: %s\n' "$1" >&2
      return 1
      ;;
  esac
}

expected_install_path() {
  source_spec=$1
  case "$source_spec" in
    npm:*)
      package_name=$(package_name_for_source "$source_spec")
      printf '%s\n' "$agent_dir/npm/node_modules/$package_name"
      ;;
    git:github.com/algal/pi-openai-server-compaction@*)
      printf '%s\n' "$agent_dir/git/github.com/algal/pi-openai-server-compaction"
      ;;
    *)
      printf 'pi-packages: unknown reviewed package source: %s\n' "$source_spec" >&2
      return 1
      ;;
  esac
}

manifest_matches() {
  package_path=$1
  expected_name=$2
  expected_version=$3
  [ -f "$package_path/package.json" ] || return 1
  # shellcheck disable=SC2016
  "$jq_bin" -e \
    --arg expected_name "$expected_name" \
    --arg expected_version "$expected_version" \
    '.name == $expected_name and .version == $expected_version' \
    "$package_path/package.json" >/dev/null 2>&1
}

git_head_matches() {
  package_path=$1
  expected_commit=$2
  [ -d "$package_path" ] || return 1
  if ! installed_commit=$("$git_bin" -C "$package_path" rev-parse HEAD 2>/dev/null); then
    return 1
  fi
  [ "$installed_commit" = "$expected_commit" ]
}

package_is_converged() {
  list_output=$1
  source_spec=$2
  expected_path=$(expected_install_path "$source_spec")
  effective_state=$("$node_bin" "$effective_state_checker" \
    "$pi_package_manager_sdk" "$agent_dir" "$source_spec" "$expected_path/index.ts") || return 1
  package_identity_configured=$(printf '%s\n' "$effective_state" |
    "$jq_bin" -r '.identityConfigured') || return 1
  package_path=$(installed_path_for_source "$list_output" "$source_spec" "$expected_path")
  [ -n "$package_path" ] || return 1
  [ "$package_path" = "$expected_path" ] || return 1

  expected_name=$(package_name_for_source "$source_spec")
  expected_version=$(package_version_for_source "$source_spec")
  manifest_matches "$package_path" "$expected_name" "$expected_version" || return 1

  printf '%s\n' "$effective_state" |
    "$jq_bin" -e '.sourceMatches and .extensionEnabled' >/dev/null 2>&1 || return 1

  case "$source_spec" in
    git:github.com/algal/pi-openai-server-compaction@*)
      git_head_matches "$package_path" 'c6d593087709e9481223dc6c6c2269b371b5e055'
      ;;
    npm:*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

list_output=$(list_packages)
for source_spec in "${package_specs[@]}"; do
  package_identity_configured=false
  if package_is_converged "$list_output" "$source_spec"; then
    printf 'pi-packages: %s is already converged\n' "$source_spec"
    continue
  fi

  if [ "$package_identity_configured" = true ]; then
    printf 'pi-packages: resetting effective configuration for reviewed source %s\n' "$source_spec"
    PI_CODING_AGENT_DIR="$agent_dir" "$pi" remove "$source_spec"
  fi
  printf 'pi-packages: installing reviewed source %s\n' "$source_spec"
  PI_CODING_AGENT_DIR="$agent_dir" "$pi" install "$source_spec"
  list_output=$(list_packages)
  if ! package_is_converged "$list_output" "$source_spec"; then
    printf 'pi-packages: source did not converge to its reviewed package path and pin: %s\n' "$source_spec" >&2
    exit 1
  fi
done
