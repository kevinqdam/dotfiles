#!/usr/bin/env bash
# Materialize the approved local Firstmate defaults without taking ownership of
# the operational home, its runtime state, or captain-selected configuration.
#
# Usage:
#   materialize-firstmate-config <canonical-firstmate-home>
#
# Missing defaults are created as ordinary mode-0600 files. Existing regular
# files are never replaced, even when their contents differ. A symlink or other
# non-regular target is a hard conflict so activation cannot turn a Home
# Manager link or unexpected object into an operational setting silently.
set -euo pipefail

usage() {
  printf 'usage: %s <canonical-firstmate-home>\n' "$(basename "$0")" >&2
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

HOME_DIR=$1
CONFIG_DIR="$HOME_DIR/config"

if [ -e "$HOME_DIR" ] || [ -L "$HOME_DIR" ]; then
  [ -d "$HOME_DIR" ] && [ ! -L "$HOME_DIR" ] || {
    printf 'firstmate-config: canonical home is not a regular directory: %s\n' "$HOME_DIR" >&2
    exit 1
  }
else
  mkdir -p "$HOME_DIR"
fi

if [ -e "$CONFIG_DIR" ] || [ -L "$CONFIG_DIR" ]; then
  [ -d "$CONFIG_DIR" ] && [ ! -L "$CONFIG_DIR" ] || {
    printf 'firstmate-config: config path is not a regular directory: %s\n' "$CONFIG_DIR" >&2
    exit 1
  }
else
  mkdir -p "$CONFIG_DIR"
fi

BACKEND='herdr
'
CREW_HARNESS='pi
'
STARTUP_MEMORY_BUDGET='7500
'
CREW_DISPATCH='{
  "rules": [
    {
      "when": "routine, well-defined, or complex implementation work",
      "use": {
        "harness": "pi",
        "model": "gpt-5.6-luna",
        "effort": "max"
      }
    },
    {
      "when": "architecture, ambiguous diagnosis, planning, security analysis, or explicit review",
      "use": {
        "harness": "pi",
        "model": "gpt-5.6-sol",
        "effort": "high"
      }
    }
  ],
  "default": {
    "harness": "pi",
    "model": "gpt-5.6-sol",
    "effort": "medium"
  }
}
'

TARGETS='backend crew-harness crew-dispatch.json startup-memory-budget'
for name in $TARGETS; do
  path="$CONFIG_DIR/$name"
  if [ -L "$path" ]; then
    printf 'firstmate-config: refusing symlink target; review and replace it manually: %s\n' "$path" >&2
    exit 1
  fi
  if [ -e "$path" ] && [ ! -f "$path" ]; then
    printf 'firstmate-config: refusing non-regular target: %s\n' "$path" >&2
    exit 1
  fi
done

write_if_absent() {
  name=$1
  content=$2
  path="$CONFIG_DIR/$name"

  if [ -f "$path" ]; then
    if printf '%s' "$content" | cmp -s "$path" -; then
      printf 'firstmate-config: unchanged %s\n' "$path"
    else
      printf 'firstmate-config: preserved locally changed %s\n' "$path"
    fi
    return 0
  fi

  tmp=$(umask 077; mktemp "$CONFIG_DIR/.firstmate-config.XXXXXX")
  if ! printf '%s' "$content" > "$tmp"; then
    rm -f "$tmp"
    printf 'firstmate-config: could not write temporary file for %s\n' "$path" >&2
    return 1
  fi
  chmod 600 "$tmp"
  if ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    printf 'firstmate-config: could not publish %s\n' "$path" >&2
    return 1
  fi
  printf 'firstmate-config: created %s\n' "$path"
}

write_if_absent backend "$BACKEND"
write_if_absent crew-harness "$CREW_HARNESS"
write_if_absent crew-dispatch.json "$CREW_DISPATCH"
write_if_absent startup-memory-budget "$STARTUP_MEMORY_BUDGET"
